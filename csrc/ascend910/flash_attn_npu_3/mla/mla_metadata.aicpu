// Source copyrights/licenses are retained in the included scheduler files.
__global__ __aicpu__ uint32_t ComputeMlaSplitBsndMetadata(void* args)
{
    using namespace flash_attn::mla;
    if (!args) return 1;
    const auto& a = *static_cast<const MlaSplitBsndMetadataArgs*>(args);
    const auto& in = a.input;
    if (!BuildSplitBsndMetadata(in.shape, in.platform, in.dtype, reinterpret_cast<uint32_t*>(in.outputAddr),
                               in.outputWords, UsedMetadataInputs(in), a.window, a.splits, a.hasSoftcap)) return 1;
    AscendC::DataStoreBarrier();
    return 0;
}

