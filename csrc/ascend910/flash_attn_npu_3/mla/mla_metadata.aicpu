    const auto& a = *static_cast<const MlaScheduledPagedMetadataArgs*>(args);
    const bool ok = !a.generate || BuildPagedMetadata(a);
    if (a.checked) {
        MlaCheckedAutoSplitSchedule checked;
        checked.blockDim = a.context.paged.blockDim;
        checked.dtype = a.context.paged.dtype;
        if (ok)
            checked.status = CheckAutoSplit(a, checked.schedule);
        StoreChecked(a.checked, checked);
    }
    AscendC::DataStoreBarrier();
    return ok ? 0 : 1;
}

__global__ __aicpu__ uint32_t ComputeMlaPrefillBsndMetadata(void* args)
{
    using namespace flash_attn::mla;
    if (!args) {
        return 1;
    }
    const auto& a = *static_cast<const MlaPrefillBsndMetadataArgs*>(args);
    const bool ok = !a.generate || BuildPrefillBsndMetadata(a);
    if (a.checked) {
        MlaCheckedAutoSplitSchedule checked;
        checked.blockDim = a.context.cores;
        checked.dtype = a.context.dtype;
        if (ok)
            checked.status = CheckPrefill(a, checked.schedule);
        StoreChecked(a.checked, checked);
    }
    AscendC::DataStoreBarrier();
    return ok ? 0 : 1;
}

// Source copyrights/licenses are retained in the included files.
__global__ __aicpu__ uint32_t ComputeMlaGqaMetadata(void* args)
{
    if (!args || !flash_attn::mla::BuildGqaMetadata(*static_cast<const flash_attn::mla::MlaGqaMetadataArgs*>(args)))
        return 1;
    AscendC::DataStoreBarrier();
    return 0;
}
