// Compile the SAME scheduler for AICPU; do not duplicate its formulas or depend
// on an installed CANN operator. Source attribution is retained in these files.

__global__ __aicpu__ uint32_t ComputeMlaDenseMetadata(void* args)
{
    using namespace flash_attn::mla;
    if (args == nullptr) {
        return 1;
    }
    const auto& input = *static_cast<const MlaMetadataArgs*>(args);
    if (input.outputAddr == 0 || input.outputAddr % alignof(int32_t) != 0 ||
        input.outputWords != kMlaDenseMetadataWords) {
        return 1;
    }
    MlaDenseMetadata metadata;
    BuildDenseMetadata(input.shape, input.platform, input.dtype, metadata,
                       reinterpret_cast<const int32_t*>(input.cacheSeqlensAddr), input.cacheSeqlensCount);
    std::memcpy(reinterpret_cast<void*>(input.outputAddr), &metadata, sizeof(metadata));
    AscendC::DataStoreBarrier();
    // Invalid schedule inputs are represented by the header, never by a stale
    // usable schedule. A consumer must check status before reading the payload.
    return 0;
}

// Dedicated entry for v2 BSND lengths. Compile the same source algorithm;
// no installed CANN operator or host copy of device lengths is involved.

__global__ __aicpu__ uint32_t ComputeMlaBsndKvLengthMetadata(void* args)
{
    using namespace flash_attn::mla;
    if (args == nullptr) {
        return 1;
    }
    const auto& input = *static_cast<const MlaMetadataArgs*>(args);
    if (!BuildBsndKvLengthMetadata(input.shape, input.platform, input.dtype,
                                   reinterpret_cast<uint32_t*>(input.outputAddr), input.outputWords,
                                   reinterpret_cast<const int32_t*>(input.cacheSeqlensAddr), input.cacheSeqlensCount)) {
        return 1;
    }
    AscendC::DataStoreBarrier();
    return 0;
}

// Dedicated v3 producer. The sequence parser/scheduler runs on AICPU;
// no host readback of prefixes or installed CANN attention operator.

__global__ __aicpu__ uint32_t ComputeMlaTndMetadata(void* args)
{
    using namespace flash_attn::mla;
    if (args == nullptr) {
        return 1;
    }
    const auto& input = *static_cast<const MlaTndMetadataArgs*>(args);
    if (!BuildTndMetadata(input.shape, input.platform, input.dtype,
                          reinterpret_cast<uint32_t*>(input.outputAddr), input.outputWords,
                          reinterpret_cast<const int32_t*>(input.cuQueryAddr), input.queryCount,
                          reinterpret_cast<const int32_t*>(input.cuKvAddr), input.kvCount)) {
        return 1;
    }
    AscendC::DataStoreBarrier();
    return 0;
}

// Dedicated v4 producer. Shared mixed-layout parser/scheduler on AICPU;
// no host readback of lengths or installed CANN attention operator.

static uint32_t ComputeMetadata(void* args, bool fromQueryPrefix)
{
    using namespace flash_attn::mla;
    if (args == nullptr) {
        return 1;
    }
    const auto& input = *static_cast<const MlaTndBsndMetadataArgs*>(args);
    if (!BuildTndBsndMetadata(input.shape, input.platform, input.dtype,
                             reinterpret_cast<uint32_t*>(input.outputAddr), input.outputWords,
                             reinterpret_cast<const int32_t*>(input.cuQueryAddr), input.queryCount,
                             reinterpret_cast<const int32_t*>(input.kvLengthsAddr), input.kvCount, fromQueryPrefix)) {
        return 1;
    }
    AscendC::DataStoreBarrier();
    return 0;
}

__global__ __aicpu__ uint32_t ComputeMlaTndBsndMetadata(void* args)
{
    return ComputeMetadata(args, false);
}

__global__ __aicpu__ uint32_t ComputeMlaTndBsndMetadataFromPrefix(void* args)
{
    return ComputeMetadata(args, true);
}

// Independent v5 producer: allocation prefixes and optional used arrays stay
// on device. Reuse sequence scheduling without any CANN attention delegation.

__global__ __aicpu__ uint32_t ComputeMlaUsedMetadata(void* args)
{
    using namespace flash_attn::mla;
    if (args == nullptr) {
        return 1;
    }
    const auto& input = *static_cast<const MlaUsedMetadataArgs*>(args);
    if (!BuildUsedMetadata(input.shape, input.platform, input.dtype,
                           reinterpret_cast<uint32_t*>(input.outputAddr), input.outputWords, UsedMetadataInputs(input))) {
        return 1;
    }
    AscendC::DataStoreBarrier();
    return 0;
}

// Standalone v6 producer: read lengths and derive TND total Q on AICPU.
// Reuse the CANN-derived scheduler/CPU wire, with no PA attention delegation.

__global__ __aicpu__ uint32_t ComputeMlaPagedMetadata(void* args)
{
    using namespace flash_attn::mla;
    if (args == nullptr) {
        return 1;
    }
    const auto& input = *static_cast<const MlaPagedMetadataArgs*>(args);
    if (!BuildPagedMetadata(input.shape, input.platform, input.dtype,
                            reinterpret_cast<uint32_t*>(input.outputAddr), input.outputWords,
                            PagedMetadataInputs(input), true)) {
        return 1;
    }
    AscendC::DataStoreBarrier();
    return 0;
}

__global__ __aicpu__ uint32_t ComputeMlaCausalPagedBsndMetadata(void* args)
{
    using namespace flash_attn::mla;
    if (args == nullptr) {
        return 1;
    }
    const auto& input = *static_cast<const MlaPagedMetadataArgs*>(args);
    if (!BuildCausalPagedBsndMetadata(input.shape, input.platform, input.dtype,
                                      reinterpret_cast<uint32_t*>(input.outputAddr), input.outputWords,
