    const auto& causal = *static_cast<const MlaCausalMetadataArgs*>(args);
    const auto& input = causal.input;
    if (!BuildCausalBsndMetadata(input.shape, input.platform, input.dtype,
                                reinterpret_cast<uint32_t*>(input.outputAddr), input.outputWords,
                                UsedMetadataInputs(input), &causal.full)) {
