#include "aicpu_api.h"
#include "mla_auto_split_bsnd_metadata.cpp"
#include "mla_auto_split_kv_plan.cpp"
#include "mla_split_kv.cpp"
#include "mla_window.cpp"
#include "mla_causal.cpp"
#include "mla_used_metadata.cpp"
#include "mla_metadata.cpp"
#include "mla_tnd_schedule.cpp"
#include "mla_schedule.cpp"
#include "detail/cann_split_core.cpp"
__global__ __aicpu__ uint32_t ComputeMlaAutoSplitBsndMetadata(void* args)
{
    using namespace flash_attn::mla;
    if (!args) return 1;
    const auto& a = *static_cast<const MlaAutoSplitBsndMetadataArgs*>(args);
    const auto& in = a.input;
    if (!BuildAutoSplitBsndMetadata(in.shape, in.platform, in.dtype, reinterpret_cast<uint32_t*>(in.outputAddr),
                                   in.outputWords, UsedMetadataInputs(in), a.window)) return 1;
    AscendC::DataStoreBarrier();
    return 0;
}
