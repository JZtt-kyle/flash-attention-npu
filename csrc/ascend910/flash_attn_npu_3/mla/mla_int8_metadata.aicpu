#include "aicpu_api.h"
#include "mla_int8_schedule.h"

__global__ __aicpu__ uint32_t ComputeMlaInt8Metadata(void* args)
{
    using namespace flash_attn::mla::Int8;
    if (!args) return 1;
    const auto& a = *static_cast<const MetadataArgs*>(args);
    if (!Valid(a.config) || !a.output) return 1;
    auto* output = reinterpret_cast<uint32_t*>(a.output);
    const auto* lengths = reinterpret_cast<const int32_t*>(a.lengths);
    auto length = [&](uint32_t b) -> int64_t { return lengths ? lengths[b] : a.config.capacity; };
    Int8TilingParams p{};
    uint32_t mode = 0;
    bool valid = Schedule(a.config, length, p, mode);
    for (uint32_t w = 0; w < kHeaderWords; ++w) output[w] = HeaderWord(a.config, w, mode, valid);
    const auto* params = reinterpret_cast<const uint32_t*>(&p);
    for (uint32_t w = 0; w < sizeof(p) / 4; ++w) output[kHeaderWords + w] = params[w];
    for (uint32_t b = 0; b < a.config.batch; ++b) output[kFixedWords + b] = uint32_t(length(b));
    AscendC::DataStoreBarrier();
    return 0;
}
