#include "aicpu_api.h"
#include "mla_gqa_metadata.cpp"
#include "mla_gqa_schedule.cpp"
#include "mla_split_kv.cpp"
#include "mla_tnd_schedule.cpp"
#include "mla_schedule.cpp"
#include "mla_window.cpp"
#include "mla_causal.cpp"
#include "detail/cann_split_core.cpp"
__global__ __aicpu__ uint32_t ComputeMlaGqaMetadata(void* args)
{
    if (!args || !flash_attn::mla::BuildGqaMetadata(*static_cast<const flash_attn::mla::MlaGqaMetadataArgs*>(args)))
        return 1;
    AscendC::DataStoreBarrier();
    return 0;
}
