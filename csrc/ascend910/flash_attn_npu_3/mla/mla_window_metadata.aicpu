// v12 BSND window producer. All dynamic lengths remain on device.
// Source copyrights/licenses are retained in the included scheduler files.
#include "aicpu_api.h"
#include "mla_window_metadata.cpp"
#include "mla_window.cpp"
#include "mla_causal.cpp"
#include "mla_used_metadata.cpp"
#include "mla_metadata.cpp"
#include "mla_tnd_schedule.cpp"
#include "mla_schedule.cpp"
#include "detail/cann_split_core.cpp"

__global__ __aicpu__ uint32_t ComputeMlaWindowBsndMetadata(void* args)
{
    using namespace flash_attn::mla;
    if (args == nullptr) {
        return 1;
    }
    const auto& window = *static_cast<const MlaWindowMetadataArgs*>(args);
    const auto& input = window.input;
    if (!BuildWindowBsndMetadata(input.shape, input.platform, input.dtype,
                                reinterpret_cast<uint32_t*>(input.outputAddr), input.outputWords,
                                UsedMetadataInputs(input), window.window)) {
        return 1;
    }
    AscendC::DataStoreBarrier();
    return 0;
}
