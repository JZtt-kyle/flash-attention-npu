// v7 BSND causal producer; all lengths remain on device. CANN-derived
// algorithm copyrights and source identities are retained in the included files.
#include "aicpu_api.h"
#include "mla_causal_metadata.cpp"
#include "mla_causal.cpp"
#include "mla_used_metadata.cpp"
#include "mla_metadata.cpp"
#include "mla_tnd_schedule.cpp"
#include "mla_schedule.cpp"
#include "detail/cann_split_core.cpp"

__global__ __aicpu__ uint32_t ComputeMlaCausalBsndMetadata(void* args)
{
    using namespace flash_attn::mla;
    if (args == nullptr) {
        return 1;
    }
    const auto& causal = *static_cast<const MlaCausalMetadataArgs*>(args);
    const auto& input = causal.input;
    if (!BuildCausalBsndMetadata(input.shape, input.platform, input.dtype,
                                reinterpret_cast<uint32_t*>(input.outputAddr), input.outputWords,
                                UsedMetadataInputs(input), &causal.full)) {
        return 1;
    }
    AscendC::DataStoreBarrier();
    return 0;
}

__global__ __aicpu__ uint32_t ComputeMlaCausalTndMetadata(void* args)
{
    using namespace flash_attn::mla;
    if (args == nullptr) {
        return 1;
    }
    const auto& input = *static_cast<const MlaUsedMetadataArgs*>(args);
    if (!BuildCausalTndMetadata(input.shape, input.platform, input.dtype,
                               reinterpret_cast<uint32_t*>(input.outputAddr), input.outputWords,
                               UsedMetadataInputs(input))) {
        return 1;
    }
    AscendC::DataStoreBarrier();
    return 0;
}
