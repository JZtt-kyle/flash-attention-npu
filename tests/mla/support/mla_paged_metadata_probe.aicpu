// Test-only wrapper around the exact production entry; no PA consumer/Trap.
#define ComputeMlaPagedMetadata ComputeMlaPagedMetadataForProbe

#define ComputeMlaCausalPagedBsndMetadata ComputeMlaCausalPagedBsndMetadataForProbe
#define ComputeMlaCausalPagedTndMetadata ComputeMlaCausalPagedTndMetadataForProbe
#define ComputeMlaWindowPagedBsndMetadata ComputeMlaWindowPagedBsndMetadataForProbe
#define ComputeMlaWindowPagedTndMetadata ComputeMlaWindowPagedTndMetadataForProbe
#include "../../../csrc/ascend910/flash_attn_npu_3/mla/mla_paged_metadata.aicpu"
#undef ComputeMlaWindowPagedTndMetadata
#undef ComputeMlaWindowPagedBsndMetadata
#undef ComputeMlaCausalPagedTndMetadata
#undef ComputeMlaPagedMetadata
#undef ComputeMlaCausalPagedBsndMetadata
#include "mla_paged_metadata_probe.h"

__global__ __aicpu__ uint32_t ProbeMlaPagedMetadata(void* args)
{
    auto& input = *static_cast<MlaPagedMetadataProbeArgs*>(args);
    const uint32_t status = ComputeMlaPagedMetadataForProbe(input.nullArgs ? nullptr : &input.input);
    *reinterpret_cast<uint32_t*>(input.statusAddr) = status;
    AscendC::DataStoreBarrier();
    return 0;
}
